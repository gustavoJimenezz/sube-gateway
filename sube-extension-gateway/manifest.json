{
  "manifest_version": 3,
  "name": "SUBE Traxion",
  "version": "1.0.0",
  "description": "Integración SUBE para Traxion",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://traxion.telerecargas.com.ar/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://traxion.telerecargas.com.ar/*"],
      "js": ["dist/content.js"],
      "css": ["dist/styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/icon-sube.jpg"],
      "matches": ["https://traxion.telerecargas.com.ar/*"]
    }
  ],
  "icons": {
    "16": "dist/icon16.png",
    "48": "dist/icon48.png",
    "128": "dist/icon128.png"
  }
}